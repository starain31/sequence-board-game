#!/usr/bin/env node

/**
 * Module dependencies.
 */
const app = require('../app');
const {socket} = require('../socket');
const {pool} = require('../database/pool');
const {migrate} = require('../database/migrate');
const {start_turn_timer, presence_changed} = require('../controller/room_game');
const presence = require('../controller/presence');
const debug = require('debug')('sequence-board-game:server');
const http = require('http');

/**
 * Get port from environment and store in Express.
 */
const port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Create HTTP server.
 */
const server = http.createServer(app);
socket.attach(server);

/**
 * Bring the database schema up to date, then listen on provided port, on all network interfaces.
 * Without a database the server cannot do anything useful, so it refuses to start.
 */

migrate({pool})
    .then(function () {
        // Plays a random card for anyone whose turn timer runs out, including games resumed after a restart.
        start_turn_timer();
        // A player leaving or coming back to their table pauses or resumes their turn.
        presence.on_change(function (room_id) {
            presence_changed(room_id).catch(function (e) {
                console.error(`Could not follow who is at ${room_id}:`, e.message);
            });
        });
        server.listen(port);
        server.on('error', onError);
        server.on('listening', onListening);
    })
    .catch(function (error) {
        console.error('Could not prepare the database: ' + (error.message || error.code));
        console.error('Is PostgreSQL running? Start it with `docker compose up db`, or set DATABASE_URL.');
        process.exit(1);
    });

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
    const port = parseInt(val, 10);

    if (isNaN(port)) {
        // named pipe
        return val;
    }

    if (port >= 0) {
        // port number
        return port;
    }

    return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
    if (error.syscall !== 'listen') {
        throw error;
    }

    const bind = typeof port === 'string'
        ? 'Pipe ' + port
        : 'Port ' + port;

    // handle specific listen errors with friendly messages
    switch (error.code) {
        case 'EACCES':
            console.error(bind + ' requires elevated privileges');
            process.exit(1);
            break;
        case 'EADDRINUSE':
            console.error(bind + ' is already in use');
            process.exit(1);
            break;
        default:
            throw error;
    }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
    const addr = server.address();
    const bind = typeof addr === 'string'
        ? 'pipe ' + addr
        : 'port ' + addr.port;
    debug('Listening on ' + bind);
    console.log(`Listening on http://localhost:${addr.port}`);
}
